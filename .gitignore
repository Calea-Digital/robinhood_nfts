# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs — ignore only `forge doc` output, not hand-written documents.
# The default template ignores all of docs/, which silently swallowed HANDOVER.md
# and the client questionnaires.
docs/book/
docs/src/

# Dotenv file
.env

# Python bytecode from docs/tools
__pycache__/

# macOS Finder metadata
.DS_Store

# Whitelist CSVs written by script/WhitelistExport.s.sol — regenerated from the chain, never committed
exports/

# The TypeScript client library (packages/contracts-client): dependencies and build output
node_modules/
packages/contracts-client/dist/
