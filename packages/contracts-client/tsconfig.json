{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "paths": {
      "@mintabear/contracts-client": [
        "./src/index.ts"
      ],
      "@mintabear/contracts-client/backend": [
        "./src/backend.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "bin",
    "scripts/*.ts",
    "vitest.config.ts"
  ]
}
